  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>com.rudikershaw.gitbuildhook</groupId>
          <artifactId>git-build-hook-maven-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.25.1</version>
          <configuration>
            <rulesUri>file:${maven.multiModuleProjectDirectory}/inception/inception-build/src/main/resources/inception/rules.xml</rulesUri>
            <!--
            <allowAnyUpdates>false</allowAnyUpdates>
            <allowMajorUpdates>false</allowMajorUpdates>
            -->
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!--
          Points git at the .githooks directory tracked in this repository so
          the pre-commit hook is enabled automatically on the first build.
          To disable, unset core.hooksPath in your local git config.
        -->
        <groupId>com.rudikershaw.gitbuildhook</groupId>
        <artifactId>git-build-hook-maven-plugin</artifactId>
        <configuration>
          <gitConfig>
            <core.hooksPath>.githooks</core.hooksPath>
          </gitConfig>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>configure</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        Checks the licenses of all third-party dependencies of the reactor against the Eclipse
        Foundation's IP database and ClearlyDefined using the Eclipse Dash License Tool. The goal is
        an aggregator, so invoke it once on the root instead of binding it to the lifecycle:

          mvn -Pdash-licenses license-tool:license-check

        The results are written to target/dash/summary. Add -Ddash.fail=true to fail the build if
        any dependency requires review.
      -->
      <id>dash-licenses</id>
      <pluginRepositories>
        <pluginRepository>
          <id>dash-licenses-releases</id>
          <url>https://repo.eclipse.org/content/repositories/dash-licenses-releases/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.eclipse.dash</groupId>
              <artifactId>license-tool-plugin</artifactId>
              <version>1.1.0</version>
              <configuration>
                <includeScope>runtime</includeScope>
                <!-- The reactor modules themselves are not third-party content -->
                <excludeGroupIds>de.tudarmstadt.ukp.inception.app</excludeGroupIds>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <profile>
      <id>spotless</id>
      <activation>
        <property>
          <name>!m2e.version</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.diffplug.spotless</groupId>
            <artifactId>spotless-maven-plugin</artifactId>
          </plugin>
        </plugins>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>com.diffplug.spotless</groupId>
              <artifactId>spotless-maven-plugin</artifactId>
              <version>3.10.4</version>
              <inherited>true</inherited>
              <configuration>
                <java>
                  <eclipse>
                    <version>4.39</version>
                    <file>${maven.multiModuleProjectDirectory}/inception/inception-build/src/main/resources/inception/DKProStyle_latest.xml</file>
                  </eclipse>
                  <removeUnusedImports />
                  <endWithNewline />
                </java>
              </configuration>
              <executions>
                <execution>
                  <id>spotless-check</id>
                  <phase>verify</phase>
                  <goals>
                    <goal>check</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
