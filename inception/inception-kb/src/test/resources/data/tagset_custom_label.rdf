<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
  <!ENTITY ex   "http://example.org/test/tagset#">
  <!ENTITY owl  "http://www.w3.org/2002/07/owl#">
  <!ENTITY xsd  "http://www.w3.org/2001/XMLSchema#">
]>
<!--
