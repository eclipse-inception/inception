{
  "name": "@inception-project/${project.artifactId}",
  "version": "${semver}",
  "author": "INCEpTION Team",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://github.com/eclipse-inception/inception#readme",
  "bugs": {
    "url": "https://github.com/eclipse-inception/inception/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eclipse-inception/inception.git"
  },
  "scripts": {
    "build": "sass --load-path=node_modules scss/inception-ui-kbp.scss ../../../target/js/de/tudarmstadt/ukp/inception/ui/kb/sass/inception-ui-kbp.css",
    "build:minified": "sass --load-path=node_modules scss/inception-ui-kbp.scss ../../../target/js/de/tudarmstadt/ukp/inception/ui/kb/sass/inception-ui-kbp.min.css --style compressed",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,ts,svelte,css,scss,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,svelte,css,scss,json}\""
  },
  "devDependencies": {
    "@inception-project/inception-support-bootstrap": "file:../../../../inception-support-bootstrap/src/main/ts",
    "bootstrap": "${bootstrap.version}",
    "eslint": "${eslint.version}",
    "neostandard": "${neostandard.version}",
    "prettier": "${prettier.version}",
    "prettier-plugin-svelte": "${prettier-plugin-svelte.version}",
    "sass": "${sass.version}",
    "typescript": "${typescript.version}"
  }
}
